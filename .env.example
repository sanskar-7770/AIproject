# Get this value from MongoDB Atlas: Connect > Drivers > Node.js
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=apexstudy
# Use this if Node reports "querySrv ECONNREFUSED" while connecting to Atlas.
MONGODB_DNS_SERVER=1.1.1.1

# Use a long random value; never commit your real .env file.
JWT_SECRET=replace-with-a-long-random-secret

# Your deployed Netlify address, or http://localhost:3000 for local development.
CLIENT_ORIGIN=http://localhost:3000
ADMIN_EMAIL=admin@apexstudy.local
ADMIN_PASSWORD=change-this-before-first-run

# Only needed after deployment if the API is on another domain.
# REACT_APP_API_URL=https://your-api-host.example.com/api
